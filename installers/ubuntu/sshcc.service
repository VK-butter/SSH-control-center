[Unit]
Description=SSH Control Center
After=network.target
ConditionPathExists=/var/lib/sshcc/config.json

[Service]
Type=simple
User=root
Group=root
Environment=SSHCC_DATA_DIR=/var/lib/sshcc
Environment=SSHCC_SOCKET=/run/sshcc/control.sock
EnvironmentFile=-/etc/sshcc/service.env
ExecStart=/usr/bin/sshcc service run
Restart=on-failure
RestartSec=5
RuntimeDirectory=sshcc
RuntimeDirectoryMode=0755
UMask=0077
KillMode=control-group
Delegate=yes
TimeoutStopSec=15
# The root service contains Owner workers in delegated cgroup v2 subgroups.

[Install]
WantedBy=multi-user.target
